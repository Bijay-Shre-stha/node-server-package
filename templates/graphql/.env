# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Choose one: mongodb, postgresql, mysql
DB_TYPE=mongodb

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/graphql-server

# PostgreSQL Connection
# POSTGRES_URI=postgresql://username:password@localhost:5432/graphql_server

# MySQL Connection
# MYSQL_URI=mysql://username:password@localhost:3306/graphql_server

# JWT Secret (for authentication)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d